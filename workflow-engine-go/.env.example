# Application config
PORT=8080
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000

# Database
DATABASE_URL=postgres://workflow:workflow_password@localhost:5432/workflow?sslmode=disable
MIGRATIONS_DIR=db/migrations

# Security
JWT_SECRET=super-secret-local-dev-key
JWT_ISSUER=loan-origination-auth

# External Services 
S3_BUCKET=workflow-documents-local
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test
SMTP_PASS=test
